# Copy to .env (git-ignored) and edit. Used by compose.yaml.

# Auth: set at least one mode, or the server refuses to start.
# Production behind Cloudflare Access with Managed OAuth (see docs/design.md, Authentication):
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Static bearer token for local development only. Generate with: openssl rand -hex 32
# Leave empty in production: clients sign in through Cloudflare Managed OAuth.
SATCHEL_TOKEN=

# Embedding model, or "off" for full-text search only. Downloads into /data/models on first use.
SATCHEL_EMBED_MODEL=Xenova/bge-small-en-v1.5

# Host data directory (only used by the bind-mount variant in compose.yaml).
# Must be writable by uid 1000 (the "node" user in the image).
SATCHEL_DATA_DIR=./data

# Only for the cloudflared sidecar in compose.yaml (a tunnel token is a secret).
# CLOUDFLARE_TUNNEL_TOKEN=
