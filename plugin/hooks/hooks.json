{
  "description": "Satchel: ask for the brief at session start, fill project/branch/commit into brief and checkpoint calls, ask for a hash-only checkpoint after git commit, session-end stub",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_satchel_)?satchel__(brief|checkpoint)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/fill-arguments.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-checkpoint.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
